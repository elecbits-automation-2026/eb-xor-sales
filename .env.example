# XOR Intake Bot — environment. Copy to .env.local for local dev.
# Defaults run the full demo with NO external services: mock LLM, mock Drive,
# in-memory DB/storage (Supabase creds absent → memory driver).

# ── LLM (Claude API — required in production) ────────────────────────────
ANTHROPIC_API_KEY=
XOR_BOT_MODEL=claude-sonnet-4-5
MOCK_LLM=true
TRIAGE_CONFIDENCE=0.75
MAX_PROBE_TURNS=3

# ── Google Drive + Sheets (required in production) ───────────────────────
# base64 of the service-account JSON key:  base64 -w0 key.json
GOOGLE_SERVICE_ACCOUNT_B64=
MOCK_DRIVE=true
# FULL-DRIVE ACCESS (optional): a Workspace user to impersonate via
# domain-wide delegation. When set, the bot acts as this user and can reach
# every folder that user can — no per-folder sharing needed — and files it
# creates are owned by this user (no service-account quota issues).
# Requires DWD granted in the Google Admin console (see README).
GOOGLE_IMPERSONATED_USER=
ACCOUNTS_PARENT_FOLDER_ID=
FUNNEL_SPREADSHEET_ID=
FUNNEL_SHEET_TAB=XOR Intake
TEMPLATES_FOLDER_ID=

# ── Supabase (Postgres "xor" schema + Storage; server-side only) ─────────
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Private bucket for customer uploads (override if the name is taken)
SUPABASE_BUCKET=intake-uploads

# ── Client accounts (Supabase Auth, used by the browser for auth ONLY) ───
# Safe to expose: the anon key is public by design and RLS is deny-all —
# data access still goes exclusively through the server routes.
# Absent → demo-mode auth (in-memory, zero keys) activates automatically.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Uploads ──────────────────────────────────────────────────────────────
MAX_UPLOAD_MB=50

# ── Knowledge base (Drive → pgvector RAG) ────────────────────────────────
EMBEDDINGS_PROVIDER=openai
EMBEDDINGS_API_KEY=
EMBEDDINGS_MODEL=text-embedding-3-small
EMBEDDINGS_DIM=1536
# Comma-separated Drive folder IDs the KB syncs from — curate before embedding.
# With GOOGLE_IMPERSONATED_USER set, the sentinel "root" indexes the ENTIRE
# My Drive of that user. ⚠ Only do this if that drive holds nothing a
# customer-facing bot must never see (financials, NDA material) — a
# dedicated curated account/folder tree is much safer.
KB_SOURCE_FOLDER_IDS=

# ── Cron auth (kb sync + handoff retry routes) ───────────────────────────
CRON_SECRET=
