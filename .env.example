# XOR Intake Bot — environment configuration
# Copy to .env and adjust:  cp .env.example .env
# Defaults below run the full demo with no keys (mock LLM + mock Drive).

# ── Modes ────────────────────────────────────────────────────────────────
# Keyword-based triage + local "Drive" under data/mock_drive/.
# Set both to false for production.
MOCK_LLM=true
MOCK_DRIVE=true

# ── LLM (real mode: MOCK_LLM=false) ──────────────────────────────────────
ANTHROPIC_API_KEY=
XOR_BOT_MODEL=claude-sonnet-4-5
# MAX_PROBE_TURNS=3
# TRIAGE_CONFIDENCE=0.75

# ── Google Drive backbone (real mode: MOCK_DRIVE=false) ──────────────────
# Service-account JSON key; share the folders/sheet with its client_email.
# GOOGLE_SERVICE_ACCOUNT_FILE=./service-account.json
ACCOUNTS_PARENT_FOLDER_ID=
FUNNEL_SPREADSHEET_ID=
FUNNEL_SHEET_TAB=XOR Intake
# Pre-filled in config.py from the Aug-2026 sitemap crawl — verify before go-live.
# TEMPLATES_FOLDER_ID=

# ── Server ───────────────────────────────────────────────────────────────
# HOST=0.0.0.0
# PORT=8000
# Lock down when the chat is embedded cross-origin, e.g. https://elecbits.in
# CORS_ORIGINS=*
# MAX_UPLOAD_MB=50
# XOR_DATA_DIR=./data
